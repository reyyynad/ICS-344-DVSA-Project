# macOS / editor junk
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets / tokens — never commit
.env
.env.*
*.pem
*.key
*real_token*
*real_jwt*

# Live captured responses (may contain PII — keep only sanitized copies)
loot/lesson2/forged_response.json
loot/**/*_real.json
loot/**/*_real.txt

# Python / Node build junk
__pycache__/
*.pyc
node_modules/
npm-debug.log
