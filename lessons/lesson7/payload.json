{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3ReceiptsBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR-DVSA-RECEIPTS-BUCKET/*"
      ]
    },
    {
      "Sid": "AllowDynamoDBDVSATablesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/DVSA-ORDERS-DB",
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/DVSA-USERS-DB"
      ]
    },
    {
      "Sid": "AllowSESSendOnly",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
